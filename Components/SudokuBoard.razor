@inherits ComponentBase
@inject IJSRuntime JsRuntime
@inject UserSettingsService SettingsService

<CascadingValue Value="@CommonData" Name="Common Data">
	<div class="parent-grid">
		<div><h5>@CommonData.CurrentTitle</h5></div>
		<div><h5>Entering  @(CommonData.NumberEntryMode ? "Numbers" : "Candidates")</h5></div>
		<div>Version: @_currentAppVersion</div>
		<div>
			<NumberedButtonsList 
				GameModeChangeRequest="GameModeChangeRequest"
				NumberedButtonClickRequest="NumberedButtonClickRequest"/>
		</div>
		<div class="sudoku-board">
			@for (int gridIdx = 0; gridIdx < 9; gridIdx++)
			{
				int idx = gridIdx;
				<SudokuGrid @ref="NewGrid" Tag=@idx SetSelectedCellRequest="SetSelectedCellRequest" BackgroundColor="@(idx % 2 == 0 ? "White" : "Gainsboro")" />
			}
		</div>
		<div>
			<ActionsList @ref="_actions"
				ClearCellRequest="ClearCellRequest"
				ActionRequest="ActionRequest"
				ResetGameRequest="ResetGameRequest"
				SaveGameRequest="SaveGameRequest"
				LoadGameRequest="LoadGameRequest"
				ClearSavedGamesRequest="ClearSavedGamesRequest" />
			</div>
		</div>
</CascadingValue>

