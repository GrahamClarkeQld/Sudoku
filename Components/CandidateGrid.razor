@inherits ComponentBase

<div class="candidate-container @GetBorderState()" >
	<Cell @ref="_numberCell" Tag=@Tag OnChildClick="ChildCellClick" IsShown=@(_value != 0) />
	<Sudoku3x3 Tag=@Tag @ref="_candidates" OnChildClick="ChildCellClick" IsShown=@(_value == 0 ) />
</div>

@code {
	[Parameter]
	public int Tag { get; set; }

	private int _value = 0;
	private bool _errorState = false;

	public void SetValue(int number)
	{
		_value = number;
		_numberCell.SetValue(number);
	}

	public int GetValue()
	{
		return _value;
	}

	[CascadingParameter(Name = "Common Data")]
	private SharedData CommonData { get; set; }

	[Parameter]
	public int ParentGrid { get; set; }

	protected override void OnInitialized()
	{
		base.OnInitialized();
	}

	private Cell _numberCell;
	private Sudoku3x3 _candidates;

	private async Task ChildCellClick(int childTag)
	{
		await OnChildClick.InvokeAsync(Tag);
	}

	[Parameter]
	public EventCallback<int> OnChildClick { get; set; }

	private string GetBorderState()
	{
		if (_errorState)
			return " reason-cannot-set";
		return ((CommonData.SelectedGrid == ParentGrid) && (CommonData.SelectedCell == Tag)) ? "selected-cell" : "unselected-cell";
	}

	public bool IsCandidateSet(int number)
	{
		return (_candidates.IsCandidateSet(number));
	}

	public bool IsEmpty()
	{
		if (_value != 0)
			return false;

		for (int number = 1; number < 10; number++)
			if (IsCandidateSet(number))
				return false;

		return true;
	}

	public void Toggle(int number)
	{
		_candidates.Cells[number - 1].Toggle();
	}

	public void ErrorState(bool setOn)
	{
		_errorState = setOn;
	}

	public void Reset()
	{
		SetValue(0);
		_candidates.Reset();
	}
}

<style>
	.candidate-container {
		display: flex;
		align-items: center;
		justify-content:center;
		position: relative;
	}

	.selected-cell {
		border: solid 2px Black;
	}

	.unselected-cell {
		border: solid 1px Gray;
	}

	.reason-cannot-set {
		border: solid 3px Red;
	}

</style>
