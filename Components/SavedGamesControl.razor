@inherits ComponentBase
@inject IJSRuntime JsRuntime

<div class="@(IsShown? "front" : "back hidden")">
	<div>
		<label for="save-game-select">Name for Game:</label>
		<input type="text" id="save-game-select" class="form-control ms-2"
			   list="names-list" @onchange="SaveGameChange" disabled="@(!CommonData.GameHasChanged)" />

		<datalist id="names-list">
			@foreach (var game in CommonData.GameNames)
			{
				<option value="@game"></option>
			}
		</datalist>
	</div>
	<div style="margin-top: 25px">
		<button class="common-button slim-button" @onclick="AddNameButtonClick" disabled="@IsNameSaveDisabled">
			Add Name to List
		</button>
	</div>
	<div style="margin-top: 25px; margin-bottom: 25px">
		@*<InputSelect @bind-Value="_selectedSavedGameId" @bind-Value:after="HandleGameSelection">*@
		<InputSelect TValue="int"
					 disabled="@(CommonData.SavedGames.Count == 0)"
					 Value="_selectedSavedGameId"
					 ValueChanged="@((int value) => HandleGameSelection(value))"
					 ValueExpression="@(() => _selectedSavedGameId)">
			<option value="-1">Load a Saved Game</option>
			@foreach (SavedGame game in CommonData.SavedGames)
			{
				<option value="@game.Id">@game.Title</option>
			}
		</InputSelect>
	</div>
	<div>
		<button class="common-button" @onclick="ClearSavedGamesButtonClick" disabled="@(CommonData.SavedGames.Count == 0)">
			Clear Saved Games
		</button>
	</div>
	<div></div>
	<div>
		<button class="common-button" @onclick="NewGameButtonClick">
			New Game
		</button>
	</div>
</div>

@code {

	[Parameter]
	public bool IsShown { get; set; } = false;	

	[CascadingParameter(Name = "Common Data")]
	private SharedData? CommonData { get; set; }

	private int _selectedSavedGameId = -1;

	[Parameter]
	public EventCallback ClearSavedGamesRequest { get; set; }

	[Parameter]
	public EventCallback<int> LoadGameRequest { get; set; }

	[Parameter]
	public EventCallback<string> SaveGameRequest { get; set; }

	[Parameter]
	public EventCallback NewGameRequest { get; set; }

	private async Task ClearSavedGamesButtonClick()
	{
		await ClearSavedGamesRequest.InvokeAsync();
	}

    private bool IsNameSaveDisabled => 
		string.IsNullOrWhiteSpace(CommonData?.CurrentTitle) || CommonData?.GameNames.Contains(CommonData.CurrentTitle) == true;

	private async Task HandleGameSelection(int savedGameId)
	{
		await LoadGameRequest.InvokeAsync(savedGameId);
	}

	private async Task NewGameButtonClick()
	{
		await NewGameRequest.InvokeAsync();	
	}

    private async Task SaveGameChange(ChangeEventArgs e)
    {
        if (e.Value.ToString() != "")
            await SaveGameRequest.InvokeAsync(e.Value.ToString());
    }

	private async Task AddNameButtonClick()
	{
		if (CommonData.CurrentTitle != "")
		{
			CommonData.GameNames.Add(CommonData.CurrentTitle);
		}
	}


}

