@inherits ComponentBase
@inject IJSRuntime JsRuntime
@inject UserSettingsService SettingsService

<CascadingValue Value="@CommonData" Name="Common Data">
	<div class="parent-grid">
		<div>
			<div style="display: inline-grid">
				<button class="common-button enter-button" @onclick="ControlPanelButtonClick">
					@GameControlPanelButtonText()
				</button>
			</div>
			<div><h5>@(CommonData.NumberEntryMode ? "Number" : "Candidate") Entry</h5></div>

			<NumberedButtonsList IsShown=@CommonData.NumbersAreActive
				GameModeChangeRequest="GameModeChangeRequest"
				NumberedButtonClickRequest="NumberedButtonClickRequest"/>
			<ActionsList @ref="_actions" IsShown=@CommonData.NumbersAreActive
						 ClearCellRequest="ClearCellRequest"
						 ActionRequest="ActionRequest"
						 ResetGameRequest="ResetGameRequest" />
			<SavedGamesControl IsShown="!CommonData.NumbersAreActive"
						 SaveGameRequest="SaveGameRequest"
						 LoadGameRequest="LoadGameRequest"
						 ClearSavedGamesRequest="ClearSavedGamesRequest" />
		</div>
		<div class="sudoku-board">
			@for (int gridIdx = 0; gridIdx < 9; gridIdx++)
			{
				int idx = gridIdx;
				<SudokuGrid @ref="NewGrid" Tag=@idx SetSelectedCellRequest="SetSelectedCellRequest" BackgroundColor="@(idx % 2 == 0 ? "White" : "Gainsboro")" />
			}
			<div class="footer-line">
				<span>Sudoku v: @CommonData.VersionNumber</span>
				<span>Copyright &copy; Graham Clarke 2026</span>
			</div>
		</div>
	</div>
</CascadingValue>

<style>
	.sudoku-board {
		display: grid;
		aspect-ratio: 1 / 1;
		grid-template-columns: repeat(3, 220px); /* 3 equal columns */
	}

	.parent-grid {
		display: inline-grid;
		justify-items: start;
		align-items: start;
		grid-template-columns: 220px 700px;
		gap: 20px;
		overflow: hidden;
	}

	.parent-table {
		border-collapse: collapse;
	}

	.enter-button {
		margin-top: 0px;
		margin-bottom: 20px;
		background-color: transparent;
	}

	.footer-line {
		grid-column: span 3;
		display: flex;
		justify-content: space-between;
		width: 100%;
	}
</style>